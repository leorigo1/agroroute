{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend-fastapi": {
      "root": "backend-fastapi/",
      "framework": "fastapi"
    },
    "frontend": {
      "root": "frontend/",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend-fastapi"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
